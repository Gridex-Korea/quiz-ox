# 서버
PORT=3000
NODE_ENV=development
# 사회자 콘솔 PIN (필수, 운영에서는 6자리 이상)
HOST_PIN=1234
# 스크린 접속 키 (스크린 URL을 아는 사람이 아무나 띄우지 못하게)
SCREEN_KEY=screen
# SQLite 파일 위치
DB_PATH=./data/ox.sqlite
# QR 코드에 들어갈 공개 URL (Cloud Run 배포 후 그 주소로)
PUBLIC_URL=http://localhost:3000
# 전화번호 자동 파기 기준(일)
RETENTION_DAYS=7
# 선택: 스냅샷을 복사할 GCS 버킷 (Cloud Run에서만)
# GCS_BUCKET=
